# Wispbyte startup
HOST=0.0.0.0
PORT=8000

# Model: replace with the model you intend to host on Wispbyte.
# The default is only a small smoke-test model.
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct
MODEL_NAME=local-model
MODEL_TRUST_REMOTE_CODE=0
MAX_INPUT_TOKENS=32768

# API authentication. Set this to a long random secret in Wispbyte's environment variables.
APP_API_KEY=

# Discord
DISCORD_TOKEN=
BOT_PREFIX=!
DISCORD_MAX_TOKENS=800
MODEL_TIMEOUT=900
BOT_DATA_DIR=./data

# Optional tool names that may be registered through the MCP relay later.
# Empty means tool registration is allowed; put comma-separated tool names here to restrict it.
MCP_ALLOWED_TOOLS=

